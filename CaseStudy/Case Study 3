<!DOCTYPE html>
<html>
<head>
    <title>Scholarship Category Program</title>
</head>
<body>

    <h2>Student Scholarship Category Checker</h2>

    <label>Enter Marks (out of 100): </label>
    <input type="number" id="marks">
    <button onclick="checkScholarship()">Submit</button>

    <p id="result"></p>

    <script>
        function checkScholarship() {
            var marks = Number(document.getElementById("marks").value);
            var result = "";

            if (marks < 0 || marks > 100) {
                result = "Invalid marks. Please enter a value between 0 and 100.";
            } else if (marks >= 90) {
                result = "Scholarship Category: Merit Scholarship (100% fee waiver)";
            } else if (marks >= 80) {
                result = "Scholarship Category: Merit Scholarship (75% fee waiver)";
            } else if (marks >= 70) {
                result = "Scholarship Category: Merit Scholarship (50% fee waiver)";
            } else if (marks >= 60) {
                result = "Scholarship Category: Need-Based Scholarship (25% fee waiver)";
            } else {
                result = "Scholarship Category: Not Eligible for Scholarship";
            }

            document.getElementById("result").innerHTML = result;
        }
    </script>

</body>
</html>
